; Engine configuration file.
; Edit using the Godot editor when possible.

config_version=5

[application]

config/name="Boardgame Network Prototype"
run/main_scene="res://scenes/Main.tscn"
config/icon="res://icon.svg"

[autoload]

NetworkClient="*res://scripts/network/NetworkClient.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR-Variable.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.07, 0.1, 0.16, 1)

[network]

limits/debugger/max_chars_per_second=32768
